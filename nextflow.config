// docker {
//    enabled = true
//    // runOptions = '--gpus=all'
// }
docker.enabled = true
process.executor = "local"

outputDir = 'outputs'
workDir = '.work'

params {
   resultsSubdir = 'results'
   resultsIndexSubdir = 'results'
}

profiles {
   with_prov {
      plugins = ['nf-prov']

      prov {
         enabled = true
         formats {
            wrroc {
               file = 'ro-crate-metadata.json'
               overwrite = true
               license = "https://spdx.org/licenses/MIT"
            }
         }
      }
   }
   test_scgpt_fine_tuning_cell_types_workflow {
      prov.formats.wrroc.file = 'outputs/test_scgpt_fine_tuning_cell_types_workflow.nf/ro-crate-metadata.json'
   }
   scGPT_finetune_integration_workflow {
      prov.formats.wrroc.file = 'outputs/scGPT_finetune_integration_workflow.nf/ro-crate-metadata.json'
   }
   scgpt {
      process.container = "cancerf-cpu"
      prov.formats.wrroc.file = 'outputs/scgpt/ro-crate-metadata.json'
      includeConfig 'workflows/scgpt/scgpt.config'
   }
   cancerf {
      process.container = "cancerf"
      prov.formats.wrroc.file = 'outputs/cancerf/ro-crate-metadata.json'
      includeConfig 'workflows/cancerf/cancerf.config'
   }
   cancerf_cpu {
      process.container = "cancerf-cpu"
      prov.formats.wrroc.file = 'outputs/cancerf/ro-crate-metadata.json'
      includeConfig 'workflows/cancerf/cancerf.config'
   }
}
